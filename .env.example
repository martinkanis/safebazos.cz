DATABASE_URL=postgres://safebazos:safebazos@localhost:5452/safebazos
APP_URL=http://localhost:3010
AUTH_SECRET=dev-secret-change-me-in-production

SMTP_HOST=localhost
SMTP_PORT=1035
MAIL_FROM="SafeBazos <info@safebazos.cz>"

# Fotky inzerátů: lokální disk, nebo S3 (když je nastavené S3_BUCKET).
STORAGE_DIR=./storage
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Admin účet — vytvoří/synchronizuje se při každém startu serveru (heslo z ENV je zdroj pravdy).
ADMIN_EMAIL=admin@safebazos.test
ADMIN_PASSWORD=admin-heslo-123

# Počet generovaných demo inzerátů doplněných na pozadí po startu (0 = žádné).
SEED_DEMO_LISTINGS=0
